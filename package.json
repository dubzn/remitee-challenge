{
  "name": "remitee-challenge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.14.1", "npm": "11.11.0" },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run infra:test",
    "contracts:check": "node scripts/contracts.ts",
    "infra:up": "node scripts/infra.ts up",
    "infra:down": "node scripts/infra.ts stop",
    "infra:reset": "node scripts/infra.ts reset",
    "infra:probe": "node scripts/infra.ts probe",
    "infra:test": "node scripts/infra.ts test",
    "infra:clean-check": "node scripts/infra.ts clean-check",
    "db:sql": "node scripts/infra.ts sql"
  },
  "dependencies": { "pg": "8.23.1" },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
