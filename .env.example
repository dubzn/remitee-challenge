# Local development only. Keep remote credentials and signing keys out of Git.
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgres://remitee:remitee_local_only@127.0.0.1:5432/remitee
DEPLOYMENT_FILE=.local/deployment.json
INDEXER_SCHEMA=escrow_index
INDEXER_PORT=42069
INDEXER_POLL_MS=1000
# Extra blocks after inclusion before indexing: integer 0..10000; default 2.
# Changing this for persisted data requires a fresh INDEXER_SCHEMA and replay.
CONFIRMATION_DELAY=2
REORG_WINDOW_SECONDS=180
