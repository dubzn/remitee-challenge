{
  "name": "remitee-challenge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run infra:test",
    "contracts:check": "node scripts/contracts.ts",
    "contracts:docs": "node scripts/contract-docs.ts",
    "poc:ponder": "npm --prefix experiments/ponder-poc run check",
    "infra:up": "node scripts/infra.ts up",
    "infra:down": "node scripts/infra.ts stop",
    "infra:reset": "node scripts/infra.ts reset",
    "infra:probe": "node scripts/infra.ts probe",
    "infra:test": "node scripts/infra.ts test",
    "infra:clean-check": "node scripts/infra.ts clean-check",
    "db:sql": "node scripts/infra.ts sql",
    "indexer:start": "node --env-file-if-exists=.env scripts/indexer.ts",
    "indexer:deploy:local": "node --env-file-if-exists=.env scripts/deploy-local.ts",
    "indexer:manifest": "node --env-file-if-exists=.env scripts/deployment-manifest.ts",
    "indexer:typecheck": "npm --workspace @remitee/indexer run typecheck",
    "indexer:unit": "node --test apps/indexer/test/unit.test.ts",
    "indexer:test": "node apps/indexer/test/integration.ts",
    "api:spec": "node scripts/api-spec.ts",
    "api:unit": "node --test apps/indexer/test/api-unit.test.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@redocly/openapi-core": "2.76.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "apps/indexer"
  ]
}
